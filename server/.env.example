# =============================================================================
# Kadina server — environment template (NO real secrets)
# Copy to server/.env for local development. On Railway, set these in the dashboard.
# =============================================================================

# --- REQUIRED ---
NODE_ENV=development
PORT=4000
DATABASE_URL=YOUR_DATABASE_URL
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
DEFAULT_ADMIN_EMAIL=admin@kadina.local
# REQUIRED when NODE_ENV=production — must NOT be admin123
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- WHATSAPP (Meta TEST / sandbox for Staging — never Production) ---
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN
# REQUIRED when NODE_ENV=production (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET
# Local-only escape hatch. MUST stay false (or unset) in Staging/Production.
ALLOW_INSECURE_WEBHOOK=false

# --- OPTIONAL ---
MEDIA_STORAGE_PATH=./uploads
BROADCAST_BATCH_SIZE=20
BROADCAST_BATCH_DELAY_MS=5000
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-20250514
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
INSTAGRAM_ACCESS_TOKEN=CHANGE_ME
INSTAGRAM_PAGE_ID=CHANGE_ME
MESSENGER_ACCESS_TOKEN=CHANGE_ME
MESSENGER_PAGE_ID=CHANGE_ME
