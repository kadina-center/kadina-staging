# =============================================================================
# Kadina client — environment template (NO real secrets)
# Copy to client/.env for local development.
# On Vercel: set these in Project → Settings → Environment Variables (Build-time).
# =============================================================================

# --- CLIENT (REQUIRED for Staging/Production build) ---
# Backend public HTTPS URL (no trailing slash), e.g. https://xxxxx.up.railway.app
VITE_API_URL=http://localhost:4000
# Usually same as VITE_API_URL (Socket.IO shares the Express HTTP server)
VITE_SOCKET_URL=http://localhost:4000
